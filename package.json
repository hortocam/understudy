{
  "name": "understudy",
  "version": "0.1.0",
  "description": "Declarative, stateful mocking of third-party APIs and webhook events from an OpenAPI spec.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ustdy": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node scripts/generate-config-schema.mjs && node scripts/generate-control-openapi.mjs",
    "prebuild": "npm run generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@scalar/json-magic": "^0.15.4",
    "@scalar/openapi-parser": "^0.29.10",
    "@scalar/openapi-upgrader": "^0.4.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "fastify": "^5.12.5",
    "jsonata": "^2.2.2",
    "yaml": "^2.9.1"
  }
}
